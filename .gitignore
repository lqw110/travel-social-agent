# ── Secrets ──────────────────────────────────────────────────────────────────
# Never commit real credentials. .env.example is the only env file that ships.
.env
.env.*
!.env.example
.streamlit/secrets.toml

# ── Personal content ─────────────────────────────────────────────────────────
# Your own photos stay on your machine.
data/photos/*
!data/photos/.gitkeep

# Saved drafts contain your story text and absolute file paths.
*.db
*.sqlite
*.sqlite3

# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
dist/
build/

# ── Editors and OS ───────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
