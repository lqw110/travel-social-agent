# Copy this file to .env and fill in your own values.
#   cp .env.example .env
#
# .env is git-ignored. Never commit real keys.

# ── Required ─────────────────────────────────────────────────────────────────
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ── Required only for publishing to Facebook ─────────────────────────────────
# Get both of these by running:
#   python scripts/check_facebook_credentials.py --write-env
#
# FACEBOOK_PAGE_ACCESS_TOKEN must be a *Page* token, not a User token.
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
GRAPH_API_VERSION=v23.0

# ── Safety ───────────────────────────────────────────────────────────────────
# true  = simulate publishing, send nothing to Facebook (recommended default)
# false = allow real posts, still only after you click the button in the app
DRY_RUN=true
